# Server
NODE_ENV=development
PORT=3000

CHECK_BROKEN_LINKS=true  # disable during dev to speed up crawls

# MongoDB Atlas
MONGODB_URI=mongodb+srv://null:null.savjd3m.mongodb.net/?appName=seo-geo-new


{
  "name": "aeo-geo-backend",
  "version": "1.0.0",
  "description": "SEO/GEO/AEO optimization SaaS backend",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx --conditions=development -r tsconfig-paths/register src/app.ts",
    "dev:worker": "tsx --conditions=development -r tsconfig-paths/register src/worker.ts",
    "build": "tsc && tsc-alias",
    "start": "node dist/app.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src/**/*.ts",
    "dev:all": "concurrently --names API,WORKER --prefix-colors cyan,yellow 'npm run dev' 'npm run dev:worker'"
  },
  "dependencies": {
    "@crawlee/playwright": "^3.17.0",
    "@google/generative-ai": "^0.21.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.219.0",
    "@opentelemetry/auto-instrumentations-node": "^0.77.0",
    "@opentelemetry/exporter-otlp-http": "^0.26.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.8.0",
    "@opentelemetry/sdk-logs": "^0.219.0",
    "@opentelemetry/sdk-metrics": "^2.8.0",
    "@opentelemetry/sdk-node": "^0.219.0",
    "@opentelemetry/sdk-trace-node": "^2.8.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.13.0",
    "cloudinary": "^2.5.0",
    "cors": "^2.8.6",
    "crawlee": "^3.11.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "groq-sdk": "^1.3.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.0",
    "multer": "^2.2.0",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.61.1",
    "robots-parser": "^3.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.7.5",
    "@types/pdf-parse": "^1.1.5",
    "concurrently": "^10.0.3",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}

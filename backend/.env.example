# Server
NODE_ENV=development
PORT=3000

# Mock flags (set to true to run pipeline without real API keys)
USE_MOCK_SERP=true
USE_MOCK_DATAFORSEO=true
USE_MOCK_LLM=false

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/aeo-geo

# Auth
JWT_SECRET=your-32-char-minimum-secret-here-replace-me
JWT_EXPIRES_IN=7d

# Upstash Redis (BullMQ backing store)
UPSTASH_REDIS_URL=rediss://your-redis-url.upstash.io:6379
UPSTASH_REDIS_TOKEN=your-upstash-token

# Google Gemini (primary LLM)
GEMINI_API_KEY=your-gemini-api-key

# Encryption (32 bytes = 64 hex chars — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your-64-char-hex-string

# Cloudinary (hero image storage)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google OAuth (GSC integration — optional for v1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/seo/google/callback

# SerpAPI (SERP data — set USE_MOCK_SERP=true to skip)
SERPAPI_KEY=

# DataForSEO (keyword data — set USE_MOCK_DATAFORSEO=true to skip)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_SANDBOX=true

# Unsplash (hero images)
UNSPLASH_ACCESS_KEY=

# Observability
LOG_LEVEL=info
OTEL_SERVICE_NAME=seo-geo-pipeline
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

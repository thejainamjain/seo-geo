JWT_SECRET=bfiweurbgwvnalwiprgbskguowncibgwlaolcnifbgikendicbrhiwoqngpighedbkwjsbfoqjebroeqrjboqwfionwbnfowencjwkebfweubgugbur
JWT_EXPIRES_IN=7d

# Upstash Redis (BullMQ backing store)
UPSTASH_REDIS_URL=
UPSTASH_REDIS_TOKEN=

# Google Gemini (secondary LLM)
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=

# Encryption (32 bytes = 64 hex chars — generate with: openssl rand -hex 32)
ENCRYPTION_KEY=

# Cloudinary (hero image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google OAuth (GSC integration — optional for v1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/seo/google/callback

# SerpAPI (SERP data)
SERPAPI_KEY=

# DataForSEO (keyword data)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_SANDBOX=false # set USE_MOCK_DATAFORSEO=true to skip

# Unsplash (hero images)
UNSPLASH_ACCESS_KEY=

# Observability
LOG_LEVEL=info
OTEL_SERVICE_NAME=seo-geo-pipeline
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
